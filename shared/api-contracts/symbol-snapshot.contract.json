{
  "contract_name": "symbol-snapshot",
  "version": "1.0.0",
  "description": "Stock symbol snapshot — giá, volume, session metadata của một mã cổ phiếu tại một thời điểm.",
  "last_updated": "2026-05-03",
  "schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "vninvest/contracts/symbol-snapshot/v1",
    "title": "SymbolSnapshot",
    "type": "object",
    "additionalProperties": false,
    "required": ["symbol", "price", "session_date", "fetched_at", "stale", "source"],
    "properties": {
      "symbol": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20,
        "description": "Mã cổ phiếu (VD: FPT, VNM, HPG)"
      },
      "price": {
        "type": ["number", "null"],
        "description": "Giá hiện tại (VND)"
      },
      "price_change": {
        "type": ["number", "null"],
        "description": "Thay đổi giá tuyệt đối so với phiên trước"
      },
      "price_change_pct": {
        "type": ["number", "null"],
        "description": "Thay đổi giá % so với phiên trước"
      },
      "volume": {
        "type": ["integer", "null"],
        "minimum": 0,
        "description": "Khối lượng giao dịch (cổ phiếu)"
      },
      "volume_vnd": {
        "type": ["number", "null"],
        "description": "Giá trị giao dịch (VND)"
      },
      "open": {
        "type": ["number", "null"],
        "description": "Giá mở cửa"
      },
      "high": {
        "type": ["number", "null"],
        "description": "Giá cao nhất phiên"
      },
      "low": {
        "type": ["number", "null"],
        "description": "Giá thấp nhất phiên"
      },
      "reference_price": {
        "type": ["number", "null"],
        "description": "Giá tham chiếu (giá đóng cửa phiên trước)"
      },
      "ceiling_price": {
        "type": ["number", "null"],
        "description": "Giá trần"
      },
      "floor_price": {
        "type": ["number", "null"],
        "description": "Giá sàn"
      },
      "session_date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Ngày phiên giao dịch (ISO date YYYY-MM-DD)"
      },
      "market_status": {
        "type": ["string", "null"],
        "enum": ["open", "closed", "pre-open", "halted", "ato", "atc", null],
        "description": "Trạng thái thị trường"
      },
      "fetched_at": {
        "type": "string",
        "format": "date-time",
        "description": "Thời điểm lấy data (ISO 8601)"
      },
      "stale": {
        "type": "boolean",
        "description": "true nếu data cũ hơn freshness threshold (mặc định 2 phút)"
      },
      "source": {
        "type": "string",
        "enum": ["live", "cache", "degraded", "legacy_sync", "core"],
        "description": "Nguồn data"
      }
    }
  },
  "example": {
    "symbol": "FPT",
    "price": 125000,
    "price_change": 2000,
    "price_change_pct": 1.63,
    "volume": 3500000,
    "volume_vnd": 437500000000,
    "open": 123000,
    "high": 126500,
    "low": 122000,
    "reference_price": 123000,
    "ceiling_price": 131610,
    "floor_price": 114390,
    "session_date": "2026-05-03",
    "market_status": "closed",
    "fetched_at": "2026-05-03T10:15:00+07:00",
    "stale": false,
    "source": "core"
  },
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-05-03",
      "changes": "Initial contract — SAAS-12 shared contract lock"
    }
  ]
}
