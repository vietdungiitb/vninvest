# Compose-level env vars cho dev stack
# Dùng bởi: docker compose --env-file compose.dev.env ...
# vnstock source override
VNSTOCK_HISTORY_SOURCE=AUTO

MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
FRONTEND_PORT=8080

# Network bind cho DB/Redis publish port.
# 127.0.0.1: an toan local-only.
# 0.0.0.0: cho phep stack Docker khac truy cap qua host.docker.internal.
DEV_BIND_HOST=127.0.0.1

# Runtime DB/Redis endpoint override cho backend/celery containers.
# Mac dinh de trong -> dung service names db/redis trong cung compose project.
# Khi DB/Redis nam stack khac, set nhu vi du duoi day:
# POSTGRES_HOST=host.docker.internal
# CELERY_BROKER_URL=redis://host.docker.internal:6379/0
# CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/0
# CACHE_REDIS_URL=redis://host.docker.internal:6379/2
# REALTIME_REDIS_URL=redis://host.docker.internal:6379/0
