# Compose-level env vars cho dev stack
# Dùng bởi: docker compose --env-file compose.dev.env ...
# vnbroker source override
VNBROKER_HISTORY_SOURCE=<REQUIRED>

MAILPIT_SMTP_PORT=1026
MAILPIT_UI_PORT=8026
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080
CORE_DB_PASSWORD=<REQUIRED>
CORE_DJANGO_SECRET_KEY=<REQUIRED>
CORE_ALLOWED_HOSTS=localhost,127.0.0.1,core-api,backend,host.docker.internal
CORE_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
CORE_PAT_PEPPER=<REQUIRED>
CORE_AD_SIGNING_SECRET=<REQUIRED>
DNSE_CREDENTIAL_FERNET_KEY=<REQUIRED>
# D-15 / SEC-02: key rieng cho secret broker, KHONG derive tu CORE_DJANGO_SECRET_KEY.
# Sinh: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sau khi set bien nay, chay `python manage.py reencrypt_broker_secrets --apply`
# de chuyen ciphertext cu sang version moi; nen giu `BROKER_SECRET_KEY_V1` de
# rollback duoc.
BROKER_SECRET_KEY=<REQUIRED>
# DNSE OpenAPI credentials (cần cho benchmark và OHLCV backfill via DNSE)
# Đăng ký tại: https://developers.dnse.com.vn/
DNSE_API_KEY=<REQUIRED>
DNSE_API_SECRET=<REQUIRED>
GRAFANA_ADMIN_PASSWORD=<REQUIRED>
LEGACY_BACKEND_URL=http://backend:8000
LEGACY_DATABASE_URL=<REQUIRED>

# Network bind cho DB/Redis publish port.
# 127.0.0.1: an toan local-only.
# 0.0.0.0: cho phep stack Docker khac truy cap qua host.docker.internal.
DEV_BIND_HOST=127.0.0.1

# Runtime DB/Redis endpoint override cho backend/celery containers.
# Mac dinh de trong -> dung service names db/redis trong cung compose project.
# Khi DB/Redis nam stack khac, set nhu vi du duoi day:
# POSTGRES_HOST=host.docker.internal
# CELERY_BROKER_URL=redis://host.docker.internal:6379/0
# CELERY_RESULT_BACKEND=redis://host.docker.internal:6379/0
# CACHE_REDIS_URL=redis://host.docker.internal:6379/2
# REALTIME_REDIS_URL=redis://host.docker.internal:6379/0

# Realtime Ticker caching
# Allow fallback to DB data if cache miss (instead of 503 error)
TICKER_CACHE_MISS_ALLOW_DEGRADED=True

# Off-peak vnbroker ingest (DB + Redis cache refresh)
OFFPEAK_VNBROKER_INGEST_ENABLED=True
OFFPEAK_VNBROKER_INGEST_CRON_HOUR=18
OFFPEAK_VNBROKER_INGEST_CRON_MINUTE=10
OFFPEAK_VNBROKER_INGEST_DAYS=5
OFFPEAK_VNBROKER_INGEST_MAX_SYMBOLS=300

# Realtime stabilization canary (Phase 4)
REALTIME_STREAM_NATIVE_TICKER_PATH_ENABLED=True
REALTIME_STREAM_PENDING_RECLAIM_ENABLED=True

# Runtime hardening defaults (phase 0-1)
VNBROKER_PROVIDER_CACHE_ENABLED=True
VNBROKER_CLIENT_CACHE_ENABLED=True
VNBROKER_PROVIDER_CACHE_TTL_SECONDS=900
VNBROKER_CLIENT_CACHE_TTL_SECONDS=900
VNBROKER_CLIENT_CACHE_MAXSIZE=512
VNBROKER_BOOTSTRAP_LOG_SUPPRESS_ENABLED=True

TICKER_PREFETCH_HOT_INTERVAL_SECONDS=5
TICKER_PREFETCH_WARM_INTERVAL_SECONDS=10
TICKER_PREFETCH_COLD_INTERVAL_SECONDS=30
TICKER_PREFETCH_SCHEDULER_INTERVAL_SECONDS=5
STREAM_CONSUMER_INTERVAL=10
REALTIME_POLL_INTERVAL=10

CHANNEL_LAYER_CAPACITY=500
CHANNEL_LAYER_EXPIRY=60
CHANNEL_LAYER_GROUP_EXPIRY=300
CHANNEL_LAYER_TICKER_CAPACITY=200
REALTIME_BROADCAST_DEGRADE_ENABLED=True
REALTIME_BROADCAST_DEGRADE_PENDING_THRESHOLD=2000
REALTIME_BROADCAST_DEGRADE_BATCH_THRESHOLD=200
REALTIME_BROADCAST_MIN_CHANGE_PCT=0.1
REALTIME_BROADCAST_FORCE_INTERVAL_S=5

REALTIME_INTRADAY_POLL_ENABLED=True
REALTIME_INTRADAY_POLL_SYMBOL_LIMIT=1200
REALTIME_INTRADAY_SKIP_IF_PREFETCH_FRESH_ENABLED=True
REALTIME_INTRADAY_SKIP_IF_PREFETCH_FRESH_SECONDS=8
INTRADAY_TICK_KEEP_DAYS=3

# Compose container resource guardrails
DB_MEM_LIMIT=1g
DB_CPUS=1.0
REDIS_MEM_LIMIT=512m
REDIS_CPUS=0.75
BACKEND_MEM_LIMIT=1g
BACKEND_CPUS=1.0
CORE_API_MEM_LIMIT=1g
CORE_API_CPUS=1.0
CELERY_WORKER_MEM_LIMIT=1200m
CELERY_WORKER_CPUS=1.5
CORE_WORKER_MEM_LIMIT=1200m
CORE_WORKER_CPUS=1.5
CELERY_BEAT_MEM_LIMIT=512m
CELERY_BEAT_CPUS=0.5
FRONTEND_MEM_LIMIT=512m
FRONTEND_CPUS=0.5
#github.com
GITHUB_CLIENT_ID=Ov23li6G1EFhZ1MyWJdD
GITHUB_CLIENT_SECRET=<REQUIRED>

# Cloudflare Turnstile — chong spam/robot dang ky tai khoan.
# KHONG bo trong o dev: `STRICT_TURNSTILE_ENFORCEMENT` default `not DEBUG`
# nen dev khong hard-fail. PRODUCTION (`DEBUG=false`) se `ImproperlyConfigured`
# neu thieu `TURNSTILE_SECRET_KEY` — dung chu khong phai im lang bo qua.
TURNSTILE_SECRET_KEY=<REQUIRED_IN_PRODUCTION>
# De rong = "chua dat" => dung default `not DEBUG`. Dat "true" de bat strict
# o moi truong (dung khi test che do strict tren dev).
STRICT_TURNSTILE_ENFORCEMENT=
# Site key cong khai (an toan de commit). Chi dung luc BUILD frontend — Vite chi
# inject bien `VITE_*` khi build, nen doi gia tri nay phai rebuild image.
VITE_TURNSTILE_SITE_KEY=<REQUIRED_IN_PRODUCTION>

# VNBROKER_GITHUB_TOKEN is read from environment
