{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://10.0.2.2:8000",
        "EXPO_PUBLIC_WS_BASE_URL": "ws://10.0.2.2:8000"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://127.0.0.1:8000",
        "EXPO_PUBLIC_WS_BASE_URL": "ws://127.0.0.1:8000"
      }
    }
  },
  "submit": {
    "production": {}
  }
}