# ─────────────────────────────────────────────────────────────────────────
# STAGING VPS — environment template
# ─────────────────────────────────────────────────────────────────────────
# FILE NÀY KHÔNG CHỨA SECRET THẬT. Copy thành `compose.staging.env` rồi điền.
#
#   cp compose.staging.env.example compose.staging.env
#   # sinh secret:
#   python -c "import secrets;print(secrets.token_urlsafe(64))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
#
# `compose.staging.env` BỊ .gitignore loại bỏ (`.gitignore:52` = `compose*.env`)
# ⇒ không bao giờ commit. `.example` được `.gitignore:53` cho phép.
#
# Bắt buộc: biến ghi `${VAR:?}` trong `docker-compose.staging.yml` sẽ **làm
# `docker compose` dừng ngay lúc parse** nếu thiếu — tốt hơn nhiều so với để
# container crash-loop. Danh sách đầy đủ ở `docker-compose.prod.yml` + overlay.
# ─────────────────────────────────────────────────────────────────────────

# ── DOMAIN ───────────────────────────────────────────────────────────────
# Dùng cho VIRTUAL_HOST + LETSENCRYPT_HOST của frontend.
STAGING_DOMAIN=staging.vietdungiitb.vn
LETSENCRYPT_EMAIL=vietdungiitb@gmail.com

# Cổng publish ra host. `frontend` đã tự proxy /api → core-api bên trong
# nginx.conf nên chỉ cần 1 cổng cho toàn bộ ứng dụng.
STAGING_HTTP_PORT=8080
STAGING_GRAFANA_PORT=3001
STAGING_PROMETHEUS_PORT=9091

APP_RELEASE=staging

# ── CORE / DJANGO ────────────────────────────────────────────────────────
# `CORE_ALLOWED_HOSTS` và `CORE_CORS_ALLOWED_ORIGINS` phải KHỚP domain.
# Lệch 1 ký tự ⇒ mọi request API trả 403 mà log nhìn rất khó hiểu.
CORE_ALLOWED_HOSTS=staging.vietdungiitb.vn
CORE_CORS_ALLOWED_ORIGINS=https://staging.vietdungiitb.vn
CORE_CORS_ALLOWED_ORIGINS_DEBUG=false
FRONTEND_URL=https://staging.vietdungiitb.vn

# `settings.py:462` raise nếu rỗng khi DEBUG=false.
CSRF_TRUSTED_ORIGINS=https://staging.vietdungiitb.vn

# ── SECRET BẮT BUỘC — dùng `openssl rand -base64 48` ──────────────────────
CORE_DJANGO_SECRET_KEY=<GENERATE_openssl_rand_-base64_48>
CORE_PAT_PEPPER=<GENERATE_openssl_rand_-base64_48>
CORE_DB_PASSWORD=<GENERATE_openssl_rand_-base64_24>

# `BROKER_SECRET_KEY` bị `checks.py:146-161` (E002) chặn nếu trông như
# placeholder (`<REQUIRED>`, `changeme`, `your_*`, `xxxx`…). Dùng chuỗi ngẫu nhiên.
BROKER_SECRET_KEY=<GENERATE_openssl_rand_-base64_32>

# ── TURNSTILE — BLOCKER ĐÃ CHỨNG MINH ────────────────────────────────────
# `docker-compose.prod.yml` **KHÔNG** truyền biến này (0 hit), trong khi
# `vninvest_core/env_validation.py:123` bắt buộc nó khi `DEBUG=false`.
# Chạy thật `manage.py check` với `DJANGO_DEBUG=0`:
#   ImproperlyConfigured: Required environment variable 'TURNSTILE_SECRET_KEY'
#   is not set
# ⇒ prod/staging crash-loop ngay lần chạy đầu nếu thiếu.
#
# Lấy ở Cloudflare Turnstile dashboard (staging.dometich cùng domain).
# Nếu chưa có, để TẠM thời giá trị Cloudflare test:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# (test key luôn pass — chỉ dùng để dựng stack, KHÔNG dùng khi lên thật).
TURNSTILE_SECRET_KEY=<PASTE_CLOUDFLARE_TURNSTILE_SECRET>
TURNSTILE_SITE_KEY=

# `VITE_TURNSTILE_SITE_KEY` là BUILD ARG (`packages/web/Dockerfile:21`).
# Prod compose không truyền ⇒ form đăng ký hiện lỗi tường minh.
VITE_TURNSTILE_SITE_KEY=<PUBLIC_SITE_KEY>

# ── MAIL ─────────────────────────────────────────────────────────────────
# Fernet key hợp lệ 44 ký tự base64. Sinh:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MAIL_CREDENTIAL_FERNET_KEY=<GENERATE_fernet_44_chars>
GOOGLE_OAUTH_REDIRECT_URI=

# ── OBSERVABILITY ────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<GENERATE_openssl_rand_-base64_24>

# ── TÙY CHỌN ─────────────────────────────────────────────────────────────
# Để trống = không build vnbroker từ Git riêng. Xem `packages/core/backend/Dockerfile`.
VNBROKER_GITHUB_TOKEN=

# Cần khi có nginx-proxy đứng trước. Mặc định = dải private (an toàn).
# TRỐNG (chuỗi rỗng) ⇒ `checks.py:57-82` báo Error vninvest_core.E001 ⇒
# `migrate`/`collectstatic` trong entrypoint.sh chết. Vì vậy đỪNG đặt rỗng.
TRUSTED_PROXY_IPS=

# ── RESOURCE — chỉnh theo RAM thật của VPS ───────────────────────────────
# Mặc định của prod compose cộng lại ~3.05 GB / 4.45 CPU cho 13 service.
# VPS 4 GB: dùng nguyên mặc định.
# VPS 2 GB: giảm bằng các biến dưới.
# CORE_API_MEM_LIMIT=512m
# CORE_WORKER_MEM_LIMIT=256m
# FRONTEND_MEM_LIMIT=512m
# PROMETHEUS_MEM_LIMIT=256m
# GRAFANA_MEM_LIMIT=256m