{
  "name": "@vninvest/web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "VNInvest shared frontend package-track shell baseline",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "build-community": "node ./scripts/build-community.mjs",
    "check:shell": "node ./scripts/check-shell.mjs",
    "check:stock-detail-shell": "node ./scripts/check-stock-detail-shell.mjs",
    "check:vip": "node ./scripts/check-vip-local-control.mjs",
    "check:dom-landmarks": "node ./scripts/check-dom-landmarks.mjs",
    "check:tokens": "node ./scripts/check-tokens.mjs",
    "test:dom-landmarks": "vitest run src/components/__tests__/dom-landmarks.component.test.tsx",
    "test:scroll-owners": "vitest run src/components/__tests__/scroll-owners.component.test.tsx",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --no-coverage",
    "test:components": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "capture:baseline": "node ./scripts/capture-baseline.mjs",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "i18n:scan": "npx i18next-scanner --config i18next-scanner.config.cjs",
    "prepare": "husky"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build-target": "./src/config/buildTarget.ts",
    "./route-catalog": "./src/app/routeCatalog.ts",
    "./navigation-catalog": "./src/app/navigationCatalog.ts",
    "./bootstrap-client": "./src/context/bootstrapClient.ts",
    "./auth-runtime": "./src/context/authRuntime.ts",
    "./auth-react": "./src/context/authReact.ts",
    "./adapters/core": "./src/adapters/core/index.ts",
    "./adapters/core-api-adapter": "./src/adapters/coreApiAdapter.ts",
    "./adapters/vip-app": "./src/adapters/vip-app/index.ts"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@casl/react": "^5.0.1",
    "@headlessui/react": "^2.1.1",
    "@heroicons/react": "^2.1.3",
    "@hookform/resolvers": "^5.4.0",
    "@iconify/react": "^6.0.1",
    "@marsidev/react-turnstile": "^1.5.2",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.2.12",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@radix-ui/react-visually-hidden": "^1.1.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/react-window": "^1.8.8",
    "ajv": "^8.20.0",
    "axios": "^1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.0",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "klinecharts": "^9.8.12",
    "lightweight-charts": "^5.1.0",
    "lodash.flattendeep": "^4.4.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router-dom": "^6.30.3",
    "react-window": "^1.8.11",
    "recharts": "^2.12.7",
    "save-svg-as-png": "^1.4.17",
    "simplebar": "^6.3.3",
    "simplebar-react": "^3.3.2",
    "tailwind-merge": "^3.3.1",
    "tailwind-sidebar": "^1.3.2",
    "vninvestcharts-widget": "^1.2.5",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.45.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^30.4.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "i18next-scanner": "^4.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-environment-node": "^29.7.0",
    "jest-location-mock": "^4.0.1",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.38",
    "prettier": "^3.8.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.1",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "git add"
    ],
    "*.{css,json,md}": [
      "prettier --write",
      "git add"
    ]
  }
}
