      "timeout_seconds": 10,
      "max_retries": 2,
      "retry_backoff_seconds": 3,
      "max_concurrent_runs": 1,
      "health_check_enabled": true,
      "health_check_interval_minutes": 2,
      "failure_threshold": 5,
      "stale_threshold_minutes": 5,
      "config": {
        "hot_limit": 200,
        "warm_limit": 600,
        "hot_interval_seconds": 3,
        "warm_interval_seconds": 5,
        "cold_interval_seconds": 15,
        "hot_shards": 4,
        "warm_shards": 6,
        "cold_shards": 6,
        "batch_size_hot": 50,
        "batch_size_warm": 60,
        "batch_size_cold": 60
      }
    },
