# SERVICE_REGISTRY_BOOTSTRAP_DATA.json
# Use this to seed ServiceDefinition + ServiceConfig for the first time

{
  "services": [
    {
      "name": "build_realtime_symbol_universe_snapshot",
      "domain": "realtime_ticker",
      "type": "beat_scheduled",
      "status": "active",
      "display_name": "Xây dựng snapshot universe realtime (phát hiện symbols theo dõi)",
      "description": "Quét toàn bộ TrackedSymbol, WatchlistItem, PriceAlertRule để xây dựng realtime symbol universe. Kết quả lưu vào cache và dùng để schedule prefetch shards theo tier (hot/warm/cold).",
      "celery_task_name": "portfolio.tasks.build_realtime_symbol_universe_snapshot",
      "celery_queue": "realtime_prefetch",
      "schedule_interval_seconds": 60,
      "timeout_seconds": 30,
      "max_retries": 3,
      "retry_backoff_seconds": 5,
      "max_concurrent_runs": 1,
      "health_check_enabled": true,
      "health_check_interval_minutes": 5,
      "failure_threshold": 3,
      "stale_threshold_minutes": 5,
      "config": {
        "universe_refresh_seconds": 60,
        "universe_symbol_limit": 1800,
        "include_group_symbols": false,
        "intraday_universe_group_ids": [],
        "intraday_universe_force_warm_tier": false
      }
    },
    {
      "name": "schedule_realtime_prefetch_shards",
      "domain": "realtime_ticker",
      "type": "beat_scheduled",
      "status": "active",
      "display_name": "Lên lịch prefetch shards theo tier",
      "description": "Lấy universe snapshot từ cache, nhóm theo tier (hot/warm/cold), chia thành shards, schedule prefetch task cho từng shard với đúng interval + batch size.",
      "celery_task_name": "portfolio.tasks.schedule_realtime_prefetch_shards",
      "celery_queue": "realtime_prefetch",
