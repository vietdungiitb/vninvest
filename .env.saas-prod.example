# ============================================================
# .env.saas-prod.example — Template cho SaaS Production Deployment
# Copy file này thành .env.production trên server, điền giá trị thực.
# Tất cả giá trị REPLACE_WITH_* phải được thay thế trước khi chạy.
# ============================================================

# ── Domain ──────────────────────────────────────────────────
DOMAIN=saas.edusuccess.vn
LETSENCRYPT_EMAIL=vietdung@edusuccess.vn

# ── App release tag (dùng làm docker image tag) ──────────────
APP_RELEASE=saas-prod

# ── Core DB (PostgreSQL 16) ──────────────────────────────────
CORE_DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_MIN32CHARS

# ── Core API Django ──────────────────────────────────────────
# Sinh bằng: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
CORE_DJANGO_SECRET_KEY=REPLACE_WITH_DJANGO_SECRET_KEY_50CHARS

# Hosts được phép (dùng domain production, không wildcard)
CORE_ALLOWED_HOSTS=saas.edusuccess.vn,localhost

# CORS origins (https://)
CORE_CORS_ALLOWED_ORIGINS=https://saas.edusuccess.vn

# Dynamic CORS allowance for API endpoints (/core/v1/* and /api/*) using token auth
CORS_API_DYNAMIC_ALLOW=true

# Dynamic CORS allowance for API endpoints (/core/v1/* and /api/*) using token auth
CORS_API_DYNAMIC_ALLOW=true

# PAT HMAC pepper — 32 char random, không để lộ, không đổi sau khi issue tokens
# Sinh bằng: python -c "import secrets; print(secrets.token_hex(16))"
CORE_PAT_PEPPER=REPLACE_WITH_32CHAR_HEX_PEPPER

# ── Grafana ──────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD
GRAFANA_ADMIN_USER=admin
GRAFANA_ROOT_URL=https://saas.edusuccess.vn/grafana

# ── Resource limits (tuỳ server) ─────────────────────────────
CORE_DB_MEM_LIMIT=1g
CORE_DB_CPUS=1.0
CORE_REDIS_MEM_LIMIT=512m
CORE_REDIS_CPUS=0.5
CORE_API_MEM_LIMIT=512m
CORE_API_CPUS=1.0
CORE_WORKER_MEM_LIMIT=256m
CORE_WORKER_CPUS=0.5
CORE_BEAT_MEM_LIMIT=128m
CORE_BEAT_CPUS=0.25
FRONTEND_MEM_LIMIT=512m
FRONTEND_CPUS=0.5
PROMETHEUS_MEM_LIMIT=512m
PROMETHEUS_MEM_CPUS=0.5
GRAFANA_MEM_LIMIT=256m
GRAFANA_CPUS=0.25

# ── Gunicorn tuning ──────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# ── Frontend / Vite ──────────────────────────────────────────
# WebSocket URL for realtime feed (price, whale alerts, dashboard updates)
# Nếu không set, tự động dùng window.location.host + /ws/realtime/
VITE_WS_BASE_URL=wss://saas.edusuccess.vn
# Disable WebSocket hoàn toàn (dùng REST polling fallback)
VITE_DISABLE_REALTIME_WEBSOCKET=false

# ── Celery ───────────────────────────────────────────────────
CELERY_CONCURRENCY=2
