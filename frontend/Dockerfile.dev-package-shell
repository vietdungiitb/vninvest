# syntax=docker/dockerfile:1.7
FROM node:20-alpine AS builder

ARG STOCKCHART_REPO=https://github.com/vietdungiitb/stockchart.git
ARG STOCKCHART_REF=dev

# 1. Fetch the renamed upstream repository directly so the build no longer
# depends on a parent-folder sibling checkout outside this repo.
RUN --mount=type=secret,id=vnbroker_github_token \
	set -eu; \
	token_file='/run/secrets/vnbroker_github_token'; \
	test -f "$token_file"; \
	token="$(cat "$token_file")"; \
	test -n "$token"; \
	apk add --no-cache git; \
	export GIT_CONFIG_COUNT=1; \
	export GIT_CONFIG_KEY_0=url."https://x-access-token:${token}@github.com/".insteadOf; \
	export GIT_CONFIG_VALUE_0=https://github.com/; \
	git clone --depth 1 --branch "${STOCKCHART_REF}" "${STOCKCHART_REPO}" /stockchart

# 2. Build the @vnstockcharts engine core and react packages from source!
WORKDIR /stockchart
RUN npm ci --legacy-peer-deps
RUN npm run build:engine-react

# 3. Proceed with building vninvest-frontend
WORKDIR /app/frontend

COPY frontend/package*.json ./
COPY frontend/patches/ ./patches/
COPY packages/web/ ../packages/web/
COPY packages/web/ ./packages/web/
RUN npm ci --legacy-peer-deps

COPY frontend/ ./
COPY packages/web/ ../packages/web/
COPY packages/web/ ./packages/web/
RUN rm -rf node_modules/@vnstockcharts \
	&& mkdir -p node_modules/@vnstockcharts \
	&& cp -r /stockchart/packages/vn-kline-engine-core node_modules/@vnstockcharts/vn-kline-engine-core \
	&& cp -r /stockchart/packages/vn-kline-engine-react node_modules/@vnstockcharts/vn-kline-engine-react \
	&& rm -rf node_modules/@vninvest/web \
	&& mkdir -p node_modules/@vninvest/web \
	&& cp -R ../packages/web/. node_modules/@vninvest/web/ \
	&& rm -rf node_modules/@vninvest/web/node_modules \
	&& rm -f node_modules/@vninvest/web/package-lock.json

ARG REACT_APP_API_BASE_URL=/api
ARG REACT_APP_ENABLE_PACKAGE_SHELL_HOST=1
ARG REACT_APP_PACKAGE_SHELL_CORE_BASE_URL=/core/v1
ARG REACT_APP_DISABLE_REALTIME_WEBSOCKET=true
ARG APP_RELEASE=dev
ENV REACT_APP_API_BASE_URL=${REACT_APP_API_BASE_URL}
ENV REACT_APP_ENABLE_PACKAGE_SHELL_HOST=${REACT_APP_ENABLE_PACKAGE_SHELL_HOST}
ENV REACT_APP_PACKAGE_SHELL_CORE_BASE_URL=${REACT_APP_PACKAGE_SHELL_CORE_BASE_URL}
ENV REACT_APP_DISABLE_REALTIME_WEBSOCKET=${REACT_APP_DISABLE_REALTIME_WEBSOCKET}
ENV APP_RELEASE=${APP_RELEASE}
ENV GENERATE_SOURCEMAP=false
ENV NODE_OPTIONS=--max-old-space-size=2048
RUN npm run build

FROM nginx:1.27-alpine
ARG APP_RELEASE=dev

LABEL org.opencontainers.image.version=${APP_RELEASE} \
	org.opencontainers.image.revision=${APP_RELEASE}

ENV APP_RELEASE=${APP_RELEASE}

COPY frontend/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/frontend/build /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]