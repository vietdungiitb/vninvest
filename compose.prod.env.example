# PRODUCTION ENVIRONMENT TEMPLATE
# Copy file này thành compose.prod.env và điền giá trị production

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Legacy Database (vninvest) - shared with old backend (read-only from core)
POSTGRES_DB=vninvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_legacy_db_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Core Database (PostgreSQL 15, separate from legacy)
# Connection URL used by core-api and core-worker
CORE_DATABASE_URL=postgres://postgres:your_core_db_password_here@db:5432/core_db

# Core Database resources
CORE_DB_PASSWORD=your_core_db_password_here
CORE_DB_MEM_LIMIT=1g
CORE_DB_CPUS=1.0

# ============================================
# REDIS CONFIGURATION
# ============================================
REALTIME_REDIS_URL=redis://core-redis:6379/0
STREAM_REDIS_URL=redis://core-redis:6379/1
REDIS_MEM_LIMIT=1g
REDIS_CPUS=1.0

# Core Redis
CORE_REDIS_MEM_LIMIT=512m
CORE_REDIS_CPUS=0.5

# ============================================
# CORE API CONFIGURATION (Python 3.13)
# ============================================
CORE_ENV=production
CORE_API_PORT=8100

# Secret key for Django (generate via: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
CORE_DJANGO_SECRET_KEY=your_core_django_secret_key_here

# Allowed hosts (comma-separated)
CORE_ALLOWED_HOSTS=saas.edusuccess.vn,127.0.0.1,localhost

# CORS allowed origins (comma-separated)
CORE_CORS_ALLOWED_ORIGINS=https://saas.edusuccess.vn

# Dynamic CORS allowance for API endpoints (/core/v1/* and /api/*) using token auth
CORS_API_DYNAMIC_ALLOW=true

# Frontend base URL used by password reset links and email callbacks
FRONTEND_URL=https://saas.edusuccess.vn

# Core API resources
CORE_API_MEM_LIMIT=256m
CORE_API_CPUS=0.5
CORE_WORKER_MEM_LIMIT=128m
CORE_WORKER_CPUS=0.25
CORE_BEAT_MEM_LIMIT=128m
CORE_BEAT_CPUS=0.25

# ============================================
# LEGACY BACKEND CONFIGURATION (Python 3.11)
# ============================================
DJANGO_SECRET_KEY=your_legacy_django_secret_key_here
DJANGO_DEBUG=false
ALLOWED_HOSTS=saas.edusuccess.vn,127.0.0.1,localhost

# Legacy to Core API communication
LEGACY_BACKEND_URL=http://backend:8000
CORE_API_URL=http://core-api:8100

# PAT pepper (must match core-api for token validation)
CORE_PAT_PEPPER=your_core_pat_pepper_here
CORE_AD_SIGNING_SECRET=your_core_ad_signing_secret_here

# ============================================
# FRONTEND CONFIGURATION
# ============================================
REACT_APP_API_BASE_URL=https://saas.edusuccess.vn/api
REACT_APP_CORE_API_BASE_URL=https://saas.edusuccess.vn/core/v1
REACT_APP_ENV=production

# ============================================
# BROKER CONFIGURATION (Message Queue)
# ============================================
CELERY_BROKER_URL=redis://core-redis:6379/3
CELERY_RESULT_BACKEND=redis://core-redis:6379/4

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_here

# ============================================
# CORE-API MAIL / GOOGLE OAUTH2 (SaaS native)
# ============================================
# Fernet key for encrypting Google OAuth2 credentials in SystemMailConfig.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production (DEBUG=False). MUST NOT be empty.
MAIL_CREDENTIAL_FERNET_KEY=your_fernet_key_here

# Google OAuth2 callback URL registered in Google Cloud Console.
# Format: https://<your-domain>/admin/identity_access/systemmailconfig/google/callback/
# Example: https://saas.edusuccess.vn/admin/identity_access/systemmailconfig/google/callback/
GOOGLE_OAUTH_REDIRECT_URI=https://saas.edusuccess.vn/admin/identity_access/systemmailconfig/google/callback/

# ============================================
# VNBROKER API CONFIGURATION
# ============================================
# Required to build/install the private vnbroker git dependency.
VNBROKER_GITHUB_TOKEN=your_github_pat_here
VNBROKER_API_KEY=your_vnbroker_api_key_here
VNBROKER_BASE_URL=https://api.vnbroker.com

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ============================================
# APP VERSION
# ============================================
APP_RELEASE=enterprise
