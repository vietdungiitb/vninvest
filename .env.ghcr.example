# .env.ghcr.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy file này thành .env trên server production, điền giá trị thực tế.
# KHÔNG commit file .env thực lên git.
#
# Usage:
#   cp .env.ghcr.example .env
#   # Chỉnh sửa .env với editor
#   APP_RELEASE=latest docker compose -f docker-compose.ghcr.yml --env-file .env pull
#   APP_RELEASE=latest docker compose -f docker-compose.ghcr.yml --env-file .env up -d --no-build
# ─────────────────────────────────────────────────────────────────────────────

# ── Release tag ──────────────────────────────────────────────────────────────
APP_RELEASE=latest
# Hoặc dùng git SHA cụ thể để pin version: APP_RELEASE=a1b2c3d

# ── GHCR owner ───────────────────────────────────────────────────────────────
GHCR_OWNER=vietdungiitb

# ── Legacy DB (postgres:15) ──────────────────────────────────────────────────
POSTGRES_DB=vninvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Core DB (postgres:16) ────────────────────────────────────────────────────
CORE_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Core API ─────────────────────────────────────────────────────────────────
CORE_DJANGO_SECRET_KEY=CHANGE_ME_50_CHAR_RANDOM_STRING
CORE_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORE_CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Legacy Backend ───────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=CHANGE_ME_50_CHAR_RANDOM_STRING
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# ── Redis ────────────────────────────────────────────────────────────────────
REALTIME_REDIS_URL=redis://core-redis:6379/0
STREAM_REDIS_URL=redis://core-redis:6379/1

# ── Frontend port ─────────────────────────────────────────────────────────────
FRONTEND_PORT=80
# Nếu dùng reverse proxy (nginx/caddy/traefik ngoài container): FRONTEND_PORT=8080

# ── Resource limits (tuỳ chỉnh theo RAM server) ──────────────────────────────
DB_MEM_LIMIT=2g
DB_CPUS=1.5
REDIS_MEM_LIMIT=512m
REDIS_CPUS=0.5
CORE_DB_MEM_LIMIT=1g
CORE_DB_CPUS=1.0
CORE_REDIS_MEM_LIMIT=256m
CORE_REDIS_CPUS=0.25
CORE_API_MEM_LIMIT=512m
CORE_API_CPUS=0.75
CORE_WORKER_MEM_LIMIT=256m
CORE_WORKER_CPUS=0.5
CORE_BEAT_MEM_LIMIT=128m
CORE_BEAT_CPUS=0.25
BACKEND_MEM_LIMIT=1500m
BACKEND_CPUS=1.5
CELERY_MEM_LIMIT=1g
CELERY_CPUS=1.0
CELERY_BEAT_MEM_LIMIT=256m
CELERY_BEAT_CPUS=0.25
FRONTEND_MEM_LIMIT=256m
FRONTEND_CPUS=0.5
