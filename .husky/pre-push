#!/usr/bin/env sh
# pre-push gate — bù cho việc bỏ PR (Copilot hết quota PR).
# Push thẳng vào dev mất điểm review ở GitHub, nên toàn bộ kiểm tra phải
# chạy cục bộ và FAIL-CLOSED. Kill-switch: SKIP_PRE_PUSH_GATE=1
#
# Đây là lý do cấm `--no-verify` cho pre-push: bỏ PR rồi còn bỏ gate
# thì commit vào dev không còn tầng kiểm tra nào.
set -e

command -v git-lfs >/dev/null 2>&1 || {
  printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."
  exit 2
}

node scripts/pre-push-gate.mjs

git lfs pre-push "$@"
