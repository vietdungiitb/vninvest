# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Docker Desktop local mac dinh: postgres
# sqlite | postgres
DB_ENGINE=postgres
SQLITE_DB_NAME=db.sqlite3

# PostgreSQL (used when DB_ENGINE=postgres)
POSTGRES_DB=vninvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WATCHLIST_SYNC_ENABLED=False
WATCHLIST_SYNC_MINUTES=15
WATCHLIST_SYNC_DAYS=5

# Realtime local dev
REALTIME_ENABLED=True
REALTIME_REDIS_URL=redis://localhost:6379/0
# redis | inmemory
REALTIME_CHANNEL_LAYER=redis

# vnstock throughput tuning (khuyen nghi cho runtime moi)
VNSTOCK_RATE_LIMIT_COOLDOWN_SECONDS=20
TICKER_PREFETCH_INTERVAL=12
TICKER_PREFETCH_BATCH_SIZE=60
TICKER_PREFETCH_SYMBOL_LIMIT=240
TICKER_PREFETCH_MAX_RETRIES=6
TICKER_PREFETCH_RETRY_BASE_SECONDS=8
TICKER_PREFETCH_RETRY_MAX_SECONDS=120
WHALE_AGGREGATE_VNSTOCK_MAX_SYMBOLS=6
STREAM_SNAPSHOT_TTL=60
STREAM_BLOCK_MS=2000
STREAM_STALE_AFTER_SECONDS=30

# Open Core quota enforcement (Slice B)
OPEN_CORE_QUOTA_ENFORCEMENT_ENABLED=False
OPEN_CORE_COMMUNITY_API_CALLS_PER_DAY=300
OPEN_CORE_COMMUNITY_AI_REGENERATE_PER_DAY=0
OPEN_CORE_COMMUNITY_WHALE_SYMBOLS_MAX=10
OPEN_CORE_COMMUNITY_EXPORTS_PER_DAY=0
OPEN_CORE_PRO_INDIVIDUAL_API_CALLS_PER_DAY=3000
OPEN_CORE_PRO_INDIVIDUAL_AI_REGENERATE_PER_DAY=30
OPEN_CORE_PRO_INDIVIDUAL_WHALE_SYMBOLS_MAX=25
OPEN_CORE_PRO_INDIVIDUAL_EXPORTS_PER_DAY=20
OPEN_CORE_PRO_TEAM_API_CALLS_PER_DAY=10000
OPEN_CORE_PRO_TEAM_AI_REGENERATE_PER_DAY=120
OPEN_CORE_PRO_TEAM_WHALE_SYMBOLS_MAX=100
OPEN_CORE_PRO_TEAM_EXPORTS_PER_DAY=100
