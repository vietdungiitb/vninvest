# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DEFAULT_FROM_EMAIL=noreply@localhost
SYSTEM_EMAIL_FALLBACK_ENABLED=True
SYSTEM_EMAIL_FALLBACK_HOST=localhost
SYSTEM_EMAIL_FALLBACK_PORT=1025
SYSTEM_EMAIL_FALLBACK_USE_TLS=False
SYSTEM_EMAIL_FALLBACK_USE_SSL=False
SYSTEM_EMAIL_FALLBACK_TIMEOUT_SECONDS=20
SYSTEM_EMAIL_FALLBACK_FROM_EMAIL=noreply@localhost
SYSTEM_EMAIL_FALLBACK_FROM_NAME=VNInvest Local

# Database
# PostgreSQL local defaults

# PostgreSQL
POSTGRES_DB=vninvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WATCHLIST_SYNC_ENABLED=False
WATCHLIST_SYNC_MINUTES=15
WATCHLIST_SYNC_DAYS=5

# Realtime local dev
REALTIME_ENABLED=True
REALTIME_REDIS_URL=redis://localhost:6379/0
# redis | inmemory
REALTIME_CHANNEL_LAYER=redis
CHANNEL_LAYER_CAPACITY=500
CHANNEL_LAYER_EXPIRY=60
CHANNEL_LAYER_GROUP_EXPIRY=300
CHANNEL_LAYER_TICKER_CAPACITY=200
REALTIME_BROADCAST_DEGRADE_ENABLED=True
REALTIME_BROADCAST_DEGRADE_PENDING_THRESHOLD=2000

# Realtime stabilization flags (20260417)
REALTIME_WS_PLAN_CACHE_ENABLED=True
REALTIME_WS_AUTH_CACHE_ENABLED=True
REALTIME_STREAM_NATIVE_TICKER_PATH_ENABLED=False
REALTIME_STREAM_PENDING_RECLAIM_ENABLED=False
REALTIME_WS_AUTH_CACHE_TTL_SECONDS=120
STREAM_PENDING_RECLAIM_IDLE_MS=60000
STREAM_PENDING_RECLAIM_BATCH=50

# vnstock throughput tuning (khuyen nghi cho runtime moi)
VNSTOCK_RATE_LIMIT_COOLDOWN_SECONDS=20
VNSTOCK_PROVIDER_CACHE_ENABLED=True
VNSTOCK_CLIENT_CACHE_ENABLED=True
VNSTOCK_PROVIDER_CACHE_TTL_SECONDS=900
VNSTOCK_CLIENT_CACHE_TTL_SECONDS=900
VNSTOCK_CLIENT_CACHE_MAXSIZE=512
VNSTOCK_BOOTSTRAP_LOG_SUPPRESS_ENABLED=True
VNSTOCK_PRICE_UNIT=THOUSAND_VND
TICKER_PREFETCH_INTERVAL=12
TICKER_PREFETCH_BATCH_SIZE=60
TICKER_PREFETCH_SYMBOL_LIMIT=240
TICKER_PREFETCH_MAX_RETRIES=6
TICKER_PREFETCH_RETRY_BASE_SECONDS=8
TICKER_PREFETCH_RETRY_MAX_SECONDS=120
WHALE_AGGREGATE_VNSTOCK_MAX_SYMBOLS=6
STREAM_SNAPSHOT_TTL=60
STREAM_BLOCK_MS=2000
STREAM_STALE_AFTER_SECONDS=30
TICKER_PREFETCH_HOT_INTERVAL_SECONDS=5
TICKER_PREFETCH_WARM_INTERVAL_SECONDS=10
TICKER_PREFETCH_COLD_INTERVAL_SECONDS=30
TICKER_PREFETCH_SCHEDULER_INTERVAL_SECONDS=3
STREAM_CONSUMER_INTERVAL=5
REALTIME_POLL_INTERVAL=10
REALTIME_INTRADAY_POLL_ENABLED=True
REALTIME_INTRADAY_POLL_SYMBOL_LIMIT=1200
REALTIME_INTRADAY_SKIP_IF_PREFETCH_FRESH_ENABLED=True
REALTIME_INTRADAY_SKIP_IF_PREFETCH_FRESH_SECONDS=8
REALTIME_BROADCAST_DEGRADE_BATCH_THRESHOLD=200

# Private GitHub dependency for vnbroker.
# Stored locally in backend/.env.dev via scripts/dev-setup.ps1.
# VNBROKER_GITHUB_TOKEN=

# Open Core quota enforcement (Slice B)
OPEN_CORE_QUOTA_ENFORCEMENT_ENABLED=False
OPEN_CORE_COMMUNITY_API_CALLS_PER_DAY=300
OPEN_CORE_COMMUNITY_AI_REGENERATE_PER_DAY=0
OPEN_CORE_COMMUNITY_WHALE_SYMBOLS_MAX=10
OPEN_CORE_COMMUNITY_EXPORTS_PER_DAY=0
OPEN_CORE_PRO_INDIVIDUAL_API_CALLS_PER_DAY=3000
OPEN_CORE_PRO_INDIVIDUAL_AI_REGENERATE_PER_DAY=30
OPEN_CORE_PRO_INDIVIDUAL_WHALE_SYMBOLS_MAX=25
OPEN_CORE_PRO_INDIVIDUAL_EXPORTS_PER_DAY=20
OPEN_CORE_PRO_TEAM_API_CALLS_PER_DAY=10000
OPEN_CORE_PRO_TEAM_AI_REGENERATE_PER_DAY=120
OPEN_CORE_PRO_TEAM_WHALE_SYMBOLS_MAX=100
OPEN_CORE_PRO_TEAM_EXPORTS_PER_DAY=100

# Whale advisory refresh fallback:
# True  -> when Celery worker is down, refresh endpoint runs sync fallback
# False -> fail-fast 503 when no worker
WHALE_ADVISORY_SYNC_FALLBACK_IF_NO_WORKER=True

# Stock AI advisory session bootstrap behavior
STOCK_AI_ADVISORY_FORCE_SYNC_FIRST_CREATE=True
STOCK_AI_ADVISORY_SYNC_FALLBACK_IF_NO_WORKER=True
