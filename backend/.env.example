# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# Docker Desktop local mac dinh: postgres
# sqlite | postgres
DB_ENGINE=postgres
SQLITE_DB_NAME=db.sqlite3

# PostgreSQL (used when DB_ENGINE=postgres)
POSTGRES_DB=vninvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
WATCHLIST_SYNC_ENABLED=False
WATCHLIST_SYNC_MINUTES=15
WATCHLIST_SYNC_DAYS=5

# Realtime local dev
REALTIME_ENABLED=True
REALTIME_REDIS_URL=redis://localhost:6379/0
# redis | inmemory
REALTIME_CHANNEL_LAYER=redis
