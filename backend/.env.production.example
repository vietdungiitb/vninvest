# Django
DJANGO_SECRET_KEY=change-me-very-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=vninvest.edusuccess.vn,localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# Database (docker service names)
DB_ENGINE=postgres
POSTGRES_DB=vninvest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Frontend origins (production domain)
CORS_ALLOWED_ORIGINS=https://vninvest.edusuccess.vn,http://vninvest.edusuccess.vn
CSRF_TRUSTED_ORIGINS=https://vninvest.edusuccess.vn,http://vninvest.edusuccess.vn
FRONTEND_BASE_URL=https://vninvest.edusuccess.vn
DEFAULT_FROM_EMAIL=noreply@vninvest.edusuccess.vn
SYSTEM_EMAIL_FALLBACK_ENABLED=False
SYSTEM_EMAIL_FALLBACK_HOST=
SYSTEM_EMAIL_FALLBACK_PORT=1025
SYSTEM_EMAIL_FALLBACK_USE_TLS=False
SYSTEM_EMAIL_FALLBACK_USE_SSL=False
SYSTEM_EMAIL_FALLBACK_TIMEOUT_SECONDS=20
SYSTEM_EMAIL_FALLBACK_FROM_EMAIL=noreply@vninvest.edusuccess.vn
SYSTEM_EMAIL_FALLBACK_FROM_NAME=VNInvest

# Redis / Celery (docker service name)
CELERY_BROKER_URL=redis://core-redis:6379/0
CELERY_RESULT_BACKEND=redis://core-redis:6379/0
CACHE_REDIS_URL=redis://core-redis:6379/2
REALTIME_REDIS_URL=redis://core-redis:6379/0
REALTIME_CHANNEL_LAYER=redis
REALTIME_ENABLED=True
CHANNEL_LAYER_CAPACITY=500
CHANNEL_LAYER_EXPIRY=60
CHANNEL_LAYER_GROUP_EXPIRY=300
CHANNEL_LAYER_TICKER_CAPACITY=200
REALTIME_BROADCAST_DEGRADE_ENABLED=True
REALTIME_BROADCAST_DEGRADE_PENDING_THRESHOLD=2000
VNSTOCK_PRICE_UNIT=THOUSAND_VND
VNSTOCK_PROVIDER_CACHE_ENABLED=True
VNSTOCK_CLIENT_CACHE_ENABLED=True
VNSTOCK_PROVIDER_CACHE_TTL_SECONDS=900
VNSTOCK_CLIENT_CACHE_TTL_SECONDS=900
VNSTOCK_CLIENT_CACHE_MAXSIZE=512
VNSTOCK_BOOTSTRAP_LOG_SUPPRESS_ENABLED=True
TICKER_PREFETCH_HOT_INTERVAL_SECONDS=5
TICKER_PREFETCH_WARM_INTERVAL_SECONDS=10
TICKER_PREFETCH_COLD_INTERVAL_SECONDS=30
TICKER_PREFETCH_SCHEDULER_INTERVAL_SECONDS=3
STREAM_CONSUMER_INTERVAL=5
REALTIME_POLL_INTERVAL=10
REALTIME_INTRADAY_POLL_ENABLED=True
REALTIME_INTRADAY_POLL_SYMBOL_LIMIT=1200
REALTIME_INTRADAY_SKIP_IF_PREFETCH_FRESH_ENABLED=True
REALTIME_INTRADAY_SKIP_IF_PREFETCH_FRESH_SECONDS=8
REALTIME_BROADCAST_DEGRADE_BATCH_THRESHOLD=200

# Runtime flags
WATCHLIST_SYNC_ENABLED=True
WATCHLIST_SYNC_MINUTES=15
WATCHLIST_SYNC_DAYS=5

ENABLE_NEW_MARKET_VIEWS=False
ENABLE_NEW_TRADING_VIEWS=False

# OpenCore quota (optional)
OPEN_CORE_QUOTA_ENFORCEMENT_ENABLED=True
OPEN_CORE_COMMUNITY_API_CALLS_PER_DAY=300
OPEN_CORE_COMMUNITY_AI_REGENERATE_PER_DAY=0
OPEN_CORE_PRO_INDIVIDUAL_API_CALLS_PER_DAY=3000
OPEN_CORE_PRO_INDIVIDUAL_AI_REGENERATE_PER_DAY=30
OPEN_CORE_PRO_TEAM_API_CALLS_PER_DAY=10000
OPEN_CORE_PRO_TEAM_AI_REGENERATE_PER_DAY=120

# Whale advisory refresh fallback when worker unavailable
# Set True to preserve UX during short worker restarts.
# Set False if you want strict async-only behavior.
WHALE_ADVISORY_SYNC_FALLBACK_IF_NO_WORKER=True

# Stock AI advisory session bootstrap/fallback behavior
STOCK_AI_ADVISORY_FORCE_SYNC_FIRST_CREATE=True
STOCK_AI_ADVISORY_SYNC_FALLBACK_IF_NO_WORKER=True

# If domain is ready for browser preload list, switch to True.
# See: https://hstspreload.org/
# DJANGO_SECURE_HSTS_PRELOAD=True

# Optional non-production fallback mail transport.
# Recommended: keep False in real production and configure SystemEmailAccount in Admin.
